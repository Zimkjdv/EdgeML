# Client-only credentials. Copy to .env.local in this directory, then fill in.
# .env.local is Git-ignored; NEVER commit a filled copy of this template.
# Existing nonempty environment variables take priority over this file.
# Do not put the Server EDGEML_API_TOKEN setting here.
# Quote passwords containing spaces or #. ${...} is kept literal, not expanded.
EDGEML_CLIENT_API_TOKEN=
DB_PASSWORD=
