{
  "name": "edgeml-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:components": "vitest run",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && vitest run",
    "test:csv": "node --experimental-strip-types --test tests/optimizationCsv.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build"
