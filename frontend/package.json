    "element-plus": "^2.9.8",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
