# Copy this file to .env and replace the placeholder with a long random value.
# Docker Compose and the local launchers will load it automatically.
EDGEML_API_TOKEN=replace-with-a-long-random-token

# API access is protected by default, even with no credentials configured.
# Local development only: explicitly set true AND clear API_TOKEN/WEB_PASSWORD.
# Managed-token creation/expiry/revocation does not toggle anonymous access.
EDGEML_ANONYMOUS_API=false

# Independent web administrator login. Use a different long password.
EDGEML_WEB_USERNAME=admin
EDGEML_WEB_PASSWORD=
# Enable only behind HTTPS; local HTTP development requires false.
EDGEML_WEB_COOKIE_SECURE=false
# For a custom deployment URL, set this JSON array to the exact browser origins.
# EDGEML_WEB_ALLOWED_ORIGINS=["https://edgeml.example.com"]
